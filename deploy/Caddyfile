    bind 127.0.0.1
    respond /healthz "ok" 200
    respond 404
}

chat.169.58.34.45.sslip.io {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8065
}

mail.veia.com.mx, autodiscover.veia.com.mx, autoconfig.veia.com.mx {
    encode zstd gzip
    reverse_proxy https://127.0.0.1:8443 {
        transport http {
            tls_insecure_skip_verify
        }
        header_up Host {http.request.host}
    }
}

veia.com.mx, www.veia.com.mx {
    encode zstd gzip
    root * /var/www/veia

    @php path *.php
    reverse_proxy @php unix//run/php/php8.4-fpm.sock {
        transport fastcgi {
            env SCRIPT_FILENAME /var/www/veia{path}
            env DOCUMENT_ROOT /var/www/veia
        }
    }

    file_server
}

